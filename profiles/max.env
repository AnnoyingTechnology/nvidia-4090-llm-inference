# Capacity limit: the model's full native 262,144-token window.
# Single request, KVarN 4/2-bit KV, with vision and prefix caching retained.
PORT=19622
HOST=0.0.0.0
SPEC=dflash2
DFLASH_TOKENS=7
PREFIX_CACHE=1
VISION=1
VISION_OFFLOAD=1
CTX=huge
